{
    "attach_print": 0,
    "channel": "Email",
    "condition": "doc.status == 'Active' and doc.end_date",
    "date_changed": "end_date",
    "days_in_advance": 30,
    "docstatus": 0,
    "doctype": "Notification",
    "document_type": "Wethaaq Contract",
    "enabled": 1,
    "event": "Days Before",
    "is_standard": 1,
    "message": "<p>Dear HR Team,</p><p>The contract for employee <b>{{ doc.employee }}</b> is expiring on <b>{{ frappe.utils.formatdate(doc.end_date) }}</b>.</p>",
    "module": "Wethaaq",
    "name": "Wethaaq Contract Expiry",
    "owner": "Administrator",
    "recipients": [
        {
            "receiver_by_role": "HR Manager"
        },
        {
            "receiver_by_role": "HR User"
        }
    ],
    "send_system_notification": 1,
    "send_to_all_assignees": 1,
    "subject": "Contract Expiring Soon: {{ doc.name }}"
}